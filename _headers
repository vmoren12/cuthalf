# Netlify · nada de caché para el HTML ni para el service worker
/*.html
  Cache-Control: public, max-age=0, must-revalidate
/
  Cache-Control: public, max-age=0, must-revalidate
/sw.js
  Cache-Control: public, max-age=0, must-revalidate
  Service-Worker-Allowed: /
# los módulos y las hojas de estilo los revalida el service worker,
# que se los lleva enteros al instalar cada versión
/src/*
  Cache-Control: public, max-age=0, must-revalidate
/css/*
  Cache-Control: public, max-age=0, must-revalidate
# Netlify no conoce la extensión y lo sirve como fichero binario; sin
# el tipo correcto, el navegador puede negarse a instalar la aplicación
/manifest.webmanifest
  Content-Type: application/manifest+json; charset=utf-8
  Cache-Control: public, max-age=0, must-revalidate
/icons/*
  Cache-Control: public, max-age=604800
